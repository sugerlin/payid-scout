{
  "manifest_version": 3,
  "name": "PayID Scout — Cloudflare.pay",
  "version": "1.1.0",
  "description": "在 cloudflare.pay 页面逐个查询候选钱包名称，并按通用价值排序。",
  "permissions": ["storage"],
  "action": {
    "default_title": "打开 PayID Scout"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cloudflare.pay/*"],
      "js": ["word-bank.js", "candidate-data.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
